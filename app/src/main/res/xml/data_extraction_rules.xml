<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Exclude search index from cloud backup for privacy -->
    <cloud-backup>
        <exclude domain="sharedpref" path="pop_search_index.xml" />
        <exclude domain="sharedpref" path="conversation_cache.xml" />
        <exclude domain="sharedpref" path="contact_cache.xml" />
        <exclude domain="database" path="custom_widgets.db" />
    </cloud-backup>

    <!-- Exclude sensitive data from device transfer for security -->
    <device-transfer>
        <exclude domain="sharedpref" path="pop_search_index.xml" />
        <exclude domain="sharedpref" path="conversation_cache.xml" />
        <exclude domain="sharedpref" path="contact_cache.xml" />
        <exclude domain="database" path="custom_widgets.db" />
    </device-transfer>
</data-extraction-rules>